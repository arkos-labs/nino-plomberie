# Clés API — Nino Plomberie 31
# Copier ce fichier en .env.local et remplir les valeurs

# ─── OpenAI (diagnostic photo IA) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Vercel Blob (upload photos urgence) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Vapi (voice agent WebRTC) ──────────────────────────────────────────────
VAPI_API_KEY=...
VAPI_PHONE_NUMBER_ID=...
VAPI_WEBHOOK_SECRET=...

# ─── Resend (envoi emails formulaires) ──────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=nino@ninoplomberie31.fr
EMAIL_TO=contact@ninoplomberie31.fr

# ─── Mapbox (carte temps réel / zone intervention) ──────────────────────────
# ⚠️  VITE_* → exposé côté client, restriction de domaine obligatoire dans Mapbox
VITE_MAPBOX_TOKEN=pk.eyJ1...

# ─── Site ───────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://ninoplomberie31.fr
NODE_ENV=development
