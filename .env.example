# Clés API — Nino Plomberie 31
# Copier ce fichier en .env.local et remplir les valeurs


# ─── Vercel Blob (upload photos urgence) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Vapi (voice agent WebRTC) ──────────────────────────────────────────────
VAPI_API_KEY=...
VAPI_PHONE_NUMBER_ID=...
VAPI_WEBHOOK_SECRET=...

# ─── Resend (envoi emails formulaires) ──────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=nino@ninoplomberie31.fr
EMAIL_TO=contact@ninoplomberie31.fr

# ─── Telegram (alertes : clic téléphone, rendez-vous, demandes de contact) ─────
# Créer le bot avec @BotFather, puis récupérer son identifiant de conversation (voir README du bot)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Optionnel : jeton personnel Calendly pour afficher nom, e-mail et horaire du rendez-vous dans l'alerte
CALENDLY_TOKEN=...

# ─── Mapbox (carte temps réel / zone intervention) ──────────────────────────
# ⚠️  VITE_* → exposé côté client, restriction de domaine obligatoire dans Mapbox
VITE_MAPBOX_TOKEN=pk.eyJ1...

# ─── Site ───────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://ninoplomberie31.fr
NODE_ENV=development
